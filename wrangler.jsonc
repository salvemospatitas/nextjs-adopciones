{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salvemospatitas",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "salvemospatitas.org", "custom_domain": true, "zone_name": "salvemospatitas.org" },
    { "pattern": "www.salvemospatitas.org", "custom_domain": true, "zone_name": "salvemospatitas.org" }
  ],
  "observability": { "enabled": true }
}
